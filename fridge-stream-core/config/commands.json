    "group": "minecraft",
    "handler": "game",
    "cost": 0,
    "examples": ["!spawn creeper", "!spawn zombie 3"]
  },
  "give": {
    "aliases": ["item"],
    "permission": "public",
    "description": "Give items to the streamer",
