    "maxQty": 64,
    "template": "give {player} {arg1} {qty}",
    "group": "minecraft",
    "handler": "game",
    "cost": 0
  },
  "heal": {
    "aliases": ["hp"],
    "permission": "public",
    "description": "Fully heal the streamer",
    "args": [],
    "template": "effect give {player} minecraft:instant_health 1 10 true",
    "group": "minecraft",
    "handler": "game",
    "cost": 0
  },
  "effect": {
    "aliases": ["potion"],
    "permission": "public",
    "description": "Apply a potion effect",
    "args": ["effect", "seconds?"],
    "defaultSeconds": 30,
    "maxSeconds": 120,
    "template": "effect give {player} {arg1} {seconds} 1 true",
    "group": "minecraft",
    "handler": "game",
    "cost": 0,
    "examples": ["!effect speed 45", "!effect regeneration"]
  },
  "inv": {
    "aliases": ["inventory"],
